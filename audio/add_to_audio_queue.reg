Windows Registry Editor Version 5.00

; ===============================
; Add to Audio Queue - TOTALLY SILENT
; ===============================

; .mp4
[HKEY_CLASSES_ROOT\SystemFileAssociations\.mp4\shell\AddToAudioQueue]
@="Add to Audio Queue"
"Icon"="D:\\Users\\joty79\\Documents\\Icons\\audio_encode.ico"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.mp4\shell\AddToAudioQueue\command]
@="wscript.exe \"D:\\Users\\joty79\\scripts\\encode\\audio\\silent_runner.vbs\" \"%1\""

