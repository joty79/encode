Windows Registry Editor Version 5.00

; ===============================
; Extract/Convert Audio - Context Menu
; Based on video_encode.reg structure
; ===============================

; ===============================
; FOLDER context menu (for batch processing)
; ===============================
[HKEY_CLASSES_ROOT\Directory\shell\AudioEncode]
@="Extract/Convert Audio (folder)"
"Icon"="D:\\Users\\joty79\\Documents\\Icons\\audio_encode.ico"

[HKEY_CLASSES_ROOT\Directory\shell\AudioEncode\command]
@="wt.exe -p \"PowerShell\" pwsh -NoProfile -ExecutionPolicy Bypass -File \"D:\\Users\\joty79\\scripts\\encode\\audio\\audio_encode.ps1\" \"%V\""

; ===============================
; VIDEO file types (extract audio)
; ===============================

; .mp4
[HKEY_CLASSES_ROOT\SystemFileAssociations\.mp4\shell\AudioEncode]
@="Extract/Convert Audio"
"Icon"="D:\\Users\\joty79\\Documents\\Icons\\audio_encode.ico"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.mp4\shell\AudioEncode\command]
@="wt.exe -p \"PowerShell\" pwsh -NoProfile -ExecutionPolicy Bypass -File \"D:\\Users\\joty79\\scripts\\encode\\audio\\audio_encode.ps1\" -InputFile \"%1\""

