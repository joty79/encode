Windows Registry Editor Version 5.00

; ===============================
; Add to Encode Queue (VIDEO) - SILENT
; ===============================

; .mp4
[HKEY_CLASSES_ROOT\SystemFileAssociations\.mp4\shell\AddToEncodeQueue]
@="Add to Encode Queue"
"Icon"="D:\\Users\\joty79\\Documents\\Icons\\ffmpeg.ico"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.mp4\shell\AddToEncodeQueue\command]
@="wscript.exe \"D:\\Users\\joty79\\scripts\\encode\\Video\\silent_runner.vbs\" \"%1\""

