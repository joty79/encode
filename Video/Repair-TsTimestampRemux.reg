Windows Registry Editor Version 5.00

; MPEG-TS timestamp tools for single .ts files

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.ts\shell\AnalyzeTsTimestamps]
@="Analyze TS timestamps"
"Icon"="D:\\Users\\joty79\\Documents\\Icons\\MediaInfo.ico"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.ts\shell\AnalyzeTsTimestamps\command]
@="wt.exe -- pwsh.exe -NoProfile -ExecutionPolicy Bypass -File \"D:\\Users\\joty79\\scripts\\encode\\Video\\Repair-TsTimestampRemux.ps1\" -Path \"%1\" -AnalyzeOnly -PauseAtEnd"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.ts\shell\FixTsToMp4NoReencode]
@="Fix TS -> MP4 (No re-encode)"
"Icon"="D:\\Users\\joty79\\Documents\\Icons\\avidemux.ico"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.ts\shell\FixTsToMp4NoReencode\command]
@="wt.exe -- pwsh.exe -NoProfile -ExecutionPolicy Bypass -File \"D:\\Users\\joty79\\scripts\\encode\\Video\\Repair-TsTimestampRemux.ps1\" -Path \"%1\" -SkipInputAnalysis -PauseAtEnd"

; Shift-only folder tools for all top-level .ts files in a folder

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\AnalyzeTsTimestamps]
@="Scan TS folder for problems"
"Icon"="D:\\Users\\joty79\\Documents\\Icons\\MediaInfo.ico"
"Extended"=""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\AnalyzeTsTimestamps\command]
@="wt.exe -- pwsh.exe -NoProfile -ExecutionPolicy Bypass -File \"D:\\Users\\joty79\\scripts\\encode\\Video\\Repair-TsTimestampRemux.ps1\" -Path \"%1\" -AnalyzeOnly -MoveProblemFiles -PauseAtEnd"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\FixTsToMp4NoReencode]
@="Fix TS -> MP4 in folder (No re-encode)"
"Icon"="D:\\Users\\joty79\\Documents\\Icons\\avidemux.ico"
"Extended"=""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\FixTsToMp4NoReencode\command]
@="wt.exe -- pwsh.exe -NoProfile -ExecutionPolicy Bypass -File \"D:\\Users\\joty79\\scripts\\encode\\Video\\Repair-TsTimestampRemux.ps1\" -Path \"%1\" -SkipInputAnalysis -PauseAtEnd"

; Shift-only folder-background tools for the current folder

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\AnalyzeTsTimestamps]
@="Scan TS folder for problems"
"Icon"="D:\\Users\\joty79\\Documents\\Icons\\MediaInfo.ico"
"Extended"=""

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\AnalyzeTsTimestamps\command]
@="wt.exe -- pwsh.exe -NoProfile -ExecutionPolicy Bypass -File \"D:\\Users\\joty79\\scripts\\encode\\Video\\Repair-TsTimestampRemux.ps1\" -Path \"%V\" -AnalyzeOnly -MoveProblemFiles -PauseAtEnd"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\FixTsToMp4NoReencode]
@="Fix TS -> MP4 in folder (No re-encode)"
"Icon"="D:\\Users\\joty79\\Documents\\Icons\\avidemux.ico"
"Extended"=""

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\FixTsToMp4NoReencode\command]
@="wt.exe -- pwsh.exe -NoProfile -ExecutionPolicy Bypass -File \"D:\\Users\\joty79\\scripts\\encode\\Video\\Repair-TsTimestampRemux.ps1\" -Path \"%V\" -SkipInputAnalysis -PauseAtEnd"
