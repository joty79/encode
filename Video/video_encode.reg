Windows Registry Editor Version 5.00

; =========================
; Folder context menu
; =========================
[HKEY_CLASSES_ROOT\Directory\shell\EncodeNvidiaH264]
@="Encode folder (NVIDIA H.264)"
"Icon"="D:\\Users\\joty79\\Documents\\Icons\\ffmpeg.ico"

[HKEY_CLASSES_ROOT\Directory\shell\EncodeNvidiaH264\command]
@="wt.exe -p \"PowerShell\" pwsh -NoProfile -ExecutionPolicy Bypass -File \"D:\\Users\\joty79\\scripts\\encode\\Video\\video_encode.ps1\" \"%V\""

