Windows Registry Editor Version 5.00

; =========================
; Convert image to ICO (silent)
; =========================

[HKEY_CLASSES_ROOT\SystemFileAssociations\.png\shell\ConvertToICO]
@="Convert to .ico"
"Icon"="D:\\Users\\joty79\\Documents\\Icons\\convert.ico"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.png\shell\ConvertToICO\command]
@="pwsh.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File \"D:\\Users\\joty79\\scripts\\encode\\icons\\convert_to_ico.ps1\" \"%1\""

